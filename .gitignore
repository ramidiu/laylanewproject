# Dependencies / build output
node_modules/
.angular/
**/dist/
**/www/
**/target/

# Binaries & archives (too large for git)
*.jar
*.war
*.tar.gz
*.tar.gz.bak*
*.zip

# Large DB dumps / backups
remitz_backup_*.sql
*.dump
# Raw SQL dumps under deploy/ (Flyway migrations live under layla-backend/.../db/migration and are NOT matched here)
deploy/remitz.sql
deploy/**/*dump*.sql

# Static asset trees (served separately, not source)
layla-static/
**/kyc-uploads*/

# Logs & OS
*.log
.DS_Store
Thumbs.db

# Local env secrets (never commit)
.env
*.env.local

# Production env secrets (never commit)
*.env.production
deploy-live/.env.production
.code-backup-before-fix1/
